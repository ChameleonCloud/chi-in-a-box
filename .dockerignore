# Ansible caches facts here
.facts/
# When ansible fails, retry files are left in the playbooks directory
*.retry
# Checksums/stamps for dependencies
*.sha256
*.gitref
# The default site-config is generated here
site-config/
# The vault passwords are stored here by convention
vault_password

# Ansible Galaxy roles and collections (regenerated by install_deps)
roles/galaxy.ansible.com/
roles/ansible_collections/
galaxy.ansible.com/

# Virtualenvs (regenerated by install_deps inside the image)
venv*
testing/.venv/

# Editable-install build dirs: host entries are symlinks to host-absolute
# paths; copying them over the image's own build dir breaks imports.
src/*/build/

# Kolla SSL certificates (dev only)
kolla/certificates
kolla/node_custom_config/certificates

# Vagrant development environment
vagrant/.vagrant
vagrant/storage
vagrant/vagrantkey*

# Python build files
*.pyc
**/__pycache__/
.pytest_cache/
