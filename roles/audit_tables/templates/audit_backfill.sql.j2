{% set id_col = item.id_column | default('id') %}
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED
-- ---
INSERT INTO openstack_audit.audit_{{ item.name }}
    (id, audit_event_type, audit_event_time, audit_changed_by, data)
SELECT
    src.{{ id_col }},
    'INSERT',
    src.created_at,
    'backfill',
    JSON_OBJECT(
        {% for col in item.columns %}'{{ col }}', src.{{ col }}{{ ',' if not loop.last }}
        {% endfor %})
FROM {{ item.source_db }}.{{ item.source_table }} src
JOIN (
    SELECT s.{{ id_col }} FROM {{ item.source_db }}.{{ item.source_table }} s
    WHERE NOT EXISTS (
        SELECT 1 FROM openstack_audit.audit_{{ item.name }} a
        WHERE a.id = s.{{ id_col }} AND a.audit_event_type = 'INSERT'
    )
) missing ON missing.{{ id_col }} = src.{{ id_col }}
{% if 'deleted_at' in item.columns %}
-- ---
INSERT INTO openstack_audit.audit_{{ item.name }}
    (id, audit_event_type, audit_event_time, audit_changed_by, data)
SELECT
    src.{{ id_col }},
    'DELETE',
    src.deleted_at,
    'backfill',
    JSON_OBJECT(
        {% for col in item.columns %}'{{ col }}', src.{{ col }}{{ ',' if not loop.last }}
        {% endfor %})
FROM {{ item.source_db }}.{{ item.source_table }} src
JOIN (
    SELECT s.{{ id_col }} FROM {{ item.source_db }}.{{ item.source_table }} s
    WHERE s.deleted_at IS NOT NULL
    AND NOT EXISTS (
        SELECT 1 FROM openstack_audit.audit_{{ item.name }} a
        WHERE a.id = s.{{ id_col }} AND a.audit_event_type = 'DELETE'
    )
) missing ON missing.{{ id_col }} = src.{{ id_col }}
{% endif %}
